#!/usr/bin/env bash
set -euo pipefail

install -d -m 0700 /etc/bidflow
aws secretsmanager get-secret-value \
  --region '${region}' \
  --secret-id '${runtime_secret_arn}' \
  --query SecretString \
  --output text > /etc/bidflow/runtime.env
chmod 0600 /etc/bidflow/runtime.env

aws secretsmanager get-secret-value \
  --region '${region}' \
  --secret-id '${database_secret_arn}' \
  --query SecretString \
  --output text > /etc/bidflow/rds-secret.json
chmod 0600 /etc/bidflow/rds-secret.json

database_host=$(jq -r '.host' /etc/bidflow/rds-secret.json)
database_port=$(jq -r '.port' /etc/bidflow/rds-secret.json)
database_username=$(jq -r '.username' /etc/bidflow/rds-secret.json)
database_password=$(jq -r '.password' /etc/bidflow/rds-secret.json)
{
  cat /etc/bidflow/runtime.env
  printf 'BIDFLOW_DATABASE_URL=jdbc:postgresql://%s:%s/bidflow\n' "$database_host" "$database_port"
  printf 'BIDFLOW_DATABASE_USER=%s\n' "$database_username"
  printf 'BIDFLOW_DATABASE_PASSWORD=%s\n' "$database_password"
} > /etc/bidflow/runtime-complete.env
chmod 0600 /etc/bidflow/runtime-complete.env

%{ if enable_managed_redis ~}
aws secretsmanager get-secret-value --region '${region}' --secret-id '${redis_secret_arn}' --query SecretString --output text > /etc/bidflow/redis-secret.json
chmod 0600 /etc/bidflow/redis-secret.json
redis_auth_token=$(jq -r '.redis_auth_token' /etc/bidflow/redis-secret.json)
printf 'SPRING_DATA_REDIS_HOST=${redis_endpoint}\nSPRING_DATA_REDIS_PORT=6379\nSPRING_DATA_REDIS_SSL_ENABLED=true\nSPRING_DATA_REDIS_PASSWORD=%s\n' "$redis_auth_token" >> /etc/bidflow/runtime-complete.env
%{ endif ~}

%{ if enable_managed_kafka ~}
printf 'SPRING_KAFKA_BOOTSTRAP_SERVERS=${kafka_bootstrap_brokers}\nSPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL\nSPRING_KAFKA_PROPERTIES_SASL_MECHANISM=AWS_MSK_IAM\n' >> /etc/bidflow/runtime-complete.env
%{ endif ~}

%{ if enable_managed_search ~}
printf 'BIDFLOW_OPENSEARCH_ENDPOINT=https://${opensearch_endpoint}\n' >> /etc/bidflow/runtime-complete.env
%{ endif ~}

aws ecr get-login-password --region '${region}' | \
  docker login --username AWS --password-stdin '${image_registry}'
docker pull '${application_image}'
docker rm -f bidflow >/dev/null 2>&1 || true
docker run --detach --name bidflow --restart unless-stopped \
  --env-file /etc/bidflow/runtime-complete.env \
  --publish 8080:8080 \
  '${application_image}'
