#!/usr/bin/env bash
set -euo pipefail

install -d -m 0700 /etc/bidflow
aws secretsmanager get-secret-value \
  --region '${region}' \
  --secret-id '${runtime_secret_arn}' \
  --query SecretString \
  --output text > /etc/bidflow/runtime.env
chmod 0600 /etc/bidflow/runtime.env

aws ecr get-login-password --region '${region}' | \
  docker login --username AWS --password-stdin '${image_registry}'
docker pull '${application_image}'
docker rm -f bidflow >/dev/null 2>&1 || true
docker run --detach --name bidflow --restart unless-stopped \
  --env-file /etc/bidflow/runtime.env \
  --publish 8080:8080 \
  '${application_image}'
