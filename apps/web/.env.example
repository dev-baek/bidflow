VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8080
VITE_AUTH_MODE=local

# Cognito 모드는 HTTPS API·WSS와 공개 설정을 모두 요구한다.
# VITE_AUTH_MODE=cognito
# VITE_COGNITO_ISSUER=https://issuer.example.test/pool
# VITE_COGNITO_ORIGIN=https://login.example.test
# VITE_COGNITO_CLIENT_ID=publicclient
# VITE_COGNITO_REDIRECT_URI=https://app.example.test/auth/callback
# Cognito 허용 로그아웃 URL: 같은 프런트엔드 origin의 /login
